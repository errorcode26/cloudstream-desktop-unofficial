CREATE TABLE IF NOT EXISTS KeyValueStore (
    key TEXT NOT NULL PRIMARY KEY,
    value TEXT NOT NULL
);

insertKeyValue:
INSERT OR REPLACE INTO KeyValueStore(key, value) VALUES (?, ?);

selectKeyValue:
SELECT value FROM KeyValueStore WHERE key = ?;

deleteKeyValue:
DELETE FROM KeyValueStore WHERE key = ?;

selectAllKeyValues:
SELECT * FROM KeyValueStore;

deleteAllKeyValues:
DELETE FROM KeyValueStore;


CREATE TABLE IF NOT EXISTS Bookmarks (
    id TEXT NOT NULL PRIMARY KEY,
    name TEXT NOT NULL,
    url TEXT NOT NULL,
    apiName TEXT NOT NULL,
    posterUrl TEXT,
    watchType INTEGER DEFAULT 0,
    dateAdded INTEGER DEFAULT 0,
    profileId INTEGER DEFAULT 0
);

insertBookmark:
INSERT OR REPLACE INTO Bookmarks(id, name, url, apiName, posterUrl, watchType, dateAdded, profileId) VALUES (?, ?, ?, ?, ?, ?, ?, ?);

deleteBookmark:
DELETE FROM Bookmarks WHERE id = ?;

selectAllBookmarks:
SELECT * FROM Bookmarks;

selectBookmarksByProfile:
SELECT * FROM Bookmarks WHERE profileId = ?;

deleteBookmarksByProfile:
DELETE FROM Bookmarks WHERE profileId = ?;

selectBookmarkById:
SELECT * FROM Bookmarks WHERE id = ?;


CREATE TABLE IF NOT EXISTS WatchHistory (
    parentId TEXT NOT NULL,
    episodeId TEXT NOT NULL,
    showName TEXT NOT NULL,
    showUrl TEXT NOT NULL,
    apiName TEXT NOT NULL,
    posterUrl TEXT,
    episodeThumbnailUrl TEXT,
    screenshotUrl TEXT,
    episode INTEGER,
    season INTEGER,
    position INTEGER NOT NULL,
    duration INTEGER NOT NULL,
    updateTime INTEGER NOT NULL,
    episodeName TEXT,
    episodeDescription TEXT,
    profileId INTEGER DEFAULT 0,
    PRIMARY KEY(parentId, episodeId)
);

insertWatchHistory:
INSERT OR REPLACE INTO WatchHistory(parentId, episodeId, showName, showUrl, apiName, posterUrl, episodeThumbnailUrl, screenshotUrl, episode, season, position, duration, updateTime, episodeName, episodeDescription, profileId) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

deleteWatchHistoryByParent:
DELETE FROM WatchHistory WHERE parentId = ?;

deleteWatchHistoryByEpisode:
DELETE FROM WatchHistory WHERE parentId = ? AND episodeId = ?;

deleteAllWatchHistory:
DELETE FROM WatchHistory;

selectAllWatchHistory:
SELECT * FROM WatchHistory ORDER BY updateTime DESC;

selectWatchHistoryByProfile:
SELECT * FROM WatchHistory WHERE profileId = ? ORDER BY updateTime DESC;

deleteWatchHistoryByProfile:
DELETE FROM WatchHistory WHERE profileId = ?;

selectWatchHistoryByParent:
SELECT * FROM WatchHistory WHERE parentId = ? ORDER BY updateTime DESC;

selectWatchHistoryByEpisode:
SELECT * FROM WatchHistory WHERE parentId = ? AND episodeId = ? LIMIT 1;

selectLatestWatchHistoryForShow:
SELECT * FROM WatchHistory WHERE showUrl = ? ORDER BY updateTime DESC LIMIT 1;

selectLatestWatchHistoryForShowByProfile:
SELECT * FROM WatchHistory WHERE showUrl = ? AND profileId = ? ORDER BY updateTime DESC LIMIT 1;


CREATE TABLE IF NOT EXISTS PluginUpdateHistory (
    pluginName TEXT NOT NULL,
    version INTEGER NOT NULL,
    iconUrl TEXT,
    timestamp INTEGER NOT NULL,
    PRIMARY KEY (pluginName, version)
);

insertPluginUpdate:
INSERT OR REPLACE INTO PluginUpdateHistory(pluginName, version, iconUrl, timestamp) VALUES (?, ?, ?, ?);

selectAllPluginUpdates:
SELECT * FROM PluginUpdateHistory ORDER BY timestamp DESC;

deleteOldPluginUpdates:
DELETE FROM PluginUpdateHistory WHERE rowid NOT IN (SELECT rowid FROM PluginUpdateHistory ORDER BY timestamp DESC LIMIT 100);

deletePluginUpdate:
DELETE FROM PluginUpdateHistory WHERE pluginName = ?;

deleteAllPluginUpdates:
DELETE FROM PluginUpdateHistory;


CREATE TABLE IF NOT EXISTS DownloadTasks (
    id TEXT NOT NULL PRIMARY KEY,
    canonicalKey TEXT NOT NULL,
    showName TEXT NOT NULL,
    showUrl TEXT NOT NULL,
    episodeTitle TEXT,
    posterUrl TEXT,
    backdropUrl TEXT,
    season INTEGER,
    episode INTEGER,
    filePath TEXT NOT NULL,
    streamUrl TEXT NOT NULL,
    totalBytes INTEGER NOT NULL,
    downloadedBytes INTEGER NOT NULL,
    status TEXT NOT NULL,
    quality INTEGER NOT NULL,
    apiName TEXT NOT NULL,
    headersJson TEXT,
    dateAdded INTEGER NOT NULL,
    dateCompleted INTEGER
);

insertDownloadTask:
INSERT OR REPLACE INTO DownloadTasks(id, canonicalKey, showName, showUrl, episodeTitle, posterUrl, backdropUrl, season, episode, filePath, streamUrl, totalBytes, downloadedBytes, status, quality, apiName, headersJson, dateAdded, dateCompleted)
VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

updateDownloadProgress:
UPDATE DownloadTasks SET downloadedBytes = ?, totalBytes = ?, status = ? WHERE id = ?;

updateDownloadStatus:
UPDATE DownloadTasks SET status = ?, dateCompleted = ? WHERE id = ?;

deleteDownloadTask:
DELETE FROM DownloadTasks WHERE id = ?;

selectAllDownloads:
SELECT * FROM DownloadTasks ORDER BY dateAdded DESC;

selectActiveDownloads:
SELECT * FROM DownloadTasks WHERE status IN ('QUEUED', 'DOWNLOADING', 'PAUSED') ORDER BY dateAdded ASC;

selectCompletedDownloads:
SELECT * FROM DownloadTasks WHERE status = 'COMPLETED' ORDER BY dateCompleted DESC;

selectDownloadById:
SELECT * FROM DownloadTasks WHERE id = ?;

selectDownloadByCanonical:
SELECT * FROM DownloadTasks WHERE canonicalKey = ? AND season = ? AND episode = ?;


CREATE TABLE IF NOT EXISTS TrackerBindings (
    profileId INTEGER NOT NULL,
    trackerId TEXT NOT NULL,
    showKey TEXT NOT NULL,
    mappedSeason INTEGER NOT NULL DEFAULT 1,
    remoteMediaId TEXT NOT NULL,
    remoteTitle TEXT NOT NULL DEFAULT '',
    bindMode TEXT NOT NULL DEFAULT 'AUTO_VERIFIED',
    episodeOffset INTEGER NOT NULL DEFAULT 0,
    expectedTotalEpisodes INTEGER,
    updatedAt INTEGER NOT NULL,
    PRIMARY KEY (profileId, trackerId, showKey, mappedSeason)
);

upsertTrackerBinding:
INSERT OR REPLACE INTO TrackerBindings(profileId, trackerId, showKey, mappedSeason, remoteMediaId, remoteTitle, bindMode, episodeOffset, expectedTotalEpisodes, updatedAt)
VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

selectTrackerBinding:
SELECT * FROM TrackerBindings WHERE profileId = ? AND trackerId = ? AND showKey = ? AND mappedSeason = ?;

selectTrackerBindingsForShow:
SELECT * FROM TrackerBindings WHERE profileId = ? AND trackerId = ? AND showKey = ?;

selectAllTrackerBindingsForProfile:
SELECT * FROM TrackerBindings WHERE profileId = ? AND trackerId = ?;

deleteTrackerBinding:
DELETE FROM TrackerBindings WHERE profileId = ? AND trackerId = ? AND showKey = ? AND mappedSeason = ?;

deleteTrackerBindingsForProfile:
DELETE FROM TrackerBindings WHERE profileId = ?;

selectAllTrackerBindings:
SELECT * FROM TrackerBindings;


CREATE TABLE IF NOT EXISTS TrackerSyncAudit (
    id INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT,
    profileId INTEGER NOT NULL,
    trackerId TEXT NOT NULL,
    showName TEXT NOT NULL,
    remoteMediaId TEXT NOT NULL,
    episodeNum INTEGER NOT NULL,
    effectiveRemoteEpisode INTEGER NOT NULL,
    oldProgress INTEGER NOT NULL DEFAULT 0,
    newProgress INTEGER NOT NULL,
    statusApplied TEXT,
    state TEXT NOT NULL DEFAULT 'PENDING',
    reason TEXT,
    timestamp INTEGER NOT NULL
);

insertTrackerSyncAudit:
INSERT INTO TrackerSyncAudit(profileId, trackerId, showName, remoteMediaId, episodeNum, effectiveRemoteEpisode, oldProgress, newProgress, statusApplied, state, reason, timestamp)
VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

selectLastInsertRowId:
SELECT last_insert_rowid();

updateTrackerSyncAuditState:
UPDATE TrackerSyncAudit SET state = ?, reason = ? WHERE id = ?;

selectTrackerSyncAudit:
SELECT * FROM TrackerSyncAudit WHERE profileId = ? AND trackerId = ? ORDER BY timestamp DESC, id DESC LIMIT 100;

pruneTrackerSyncAudit:
DELETE FROM TrackerSyncAudit WHERE trackerId = ? AND id NOT IN (
    SELECT id FROM TrackerSyncAudit WHERE trackerId = ? ORDER BY timestamp DESC, id DESC LIMIT 500
);

selectAllTrackerSyncAudits:
SELECT * FROM TrackerSyncAudit ORDER BY id ASC;

